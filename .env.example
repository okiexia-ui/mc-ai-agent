# 复制此文件为 .env，按 config.json 里的 provider 填对应的 key

# 方案A（推荐，免费、国内直连）：智谱 GLM
# 去 https://open.bigmodel.cn/usercenter/apikeys 创建
ZHIPU_API_KEY=

# 方案B：DeepSeek（便宜、国内直连）
# 去 https://platform.deepseek.com/api_keys 创建
DEEPSEEK_API_KEY=

# 方案C：Google Gemini（免费但国内连不上，需代理）
GEMINI_API_KEY=

# 方案D：OpenRouter（免费池常限流）
OPENROUTER_API_KEY=
